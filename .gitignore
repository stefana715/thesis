# Python
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Local config / secrets
.env
*.env
configs/config.local.yaml

# Data artifacts that should not be tracked by default
data/raw/*
data/interim/*
data/processed/*
data/external/*

# Keep placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# 500 m grid product (1.2 MB). Nearly every downstream script takes it as an
# input, so a snapshot without it cannot be run.
!data/processed/grid_changsha_urban_core_solar_baseline.geojson
!data/external/.gitkeep
# Minimal reproducible subset for the OSM-quality check — a few hundred kB.
# Committed deliberately: Overture retains only its two most recent releases,
# so a pinned release tag alone does not survive long term.
!data/external/osm_quality_match_archive.geojson

# Output artifacts
outputs/figures/*
outputs/tables/*

# Keep placeholders
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Manuscript drafts kept outside version control
writing/
